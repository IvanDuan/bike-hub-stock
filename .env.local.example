# Supabase (required for production shared data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App URL for invite links (use your Mac LAN IP when staff open email on phone)
# Example: http://192.168.1.39:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Server-only — required for Admin → Send invite (never expose to the browser)
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI (optional, for AI title from bike photo)
OPENAI_API_KEY=your-openai-api-key

# Force demo mode even with Supabase configured (optional, for local UI testing only)
# NEXT_PUBLIC_USE_DEMO=true
